{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Business Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Active Orders",
      "targets": [{ "expr": "delivery_active_orders", "refId": "A" }],
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Active Riders",
      "targets": [{ "expr": "delivery_active_riders", "refId": "A" }],
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "GPS Updates / Second",
      "targets": [{ "expr": "delivery_gps_updates_per_second", "legendFormat": "GPS/s", "refId": "A" }],
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "id": 4
    },
    {
      "type": "row",
      "title": "AI Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "AI Engine P95 Latency",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(delivery_ai_request_duration_seconds_bucket[5m])))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "OSRM P95 Latency",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(delivery_osrm_request_duration_seconds_bucket[5m])))",
        "legendFormat": "{{operation}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "id": 7
    },
    {
      "type": "row",
      "title": "System Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ Queue Depth",
      "targets": [{
        "expr": "sum by (queue) (rabbitmq_queue_messages)",
        "legendFormat": "{{queue}}",
        "refId": "A"
      }],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Rate Limit Rejections",
      "targets": [{
        "expr": "sum by (endpoint) (rate(delivery_rate_limit_rejections_total[5m]))",
        "legendFormat": "{{endpoint}}",
        "refId": "A"
      }],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 15 },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Token Refresh Failures",
      "targets": [{
        "expr": "sum by (reason) (rate(delivery_token_refresh_failures_total[5m]))",
        "legendFormat": "{{reason}}",
        "refId": "A"
      }],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 15 },
      "id": 11
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["delivery", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Delivery Operations",
  "uid": "delivery-operations",
  "version": 1
