{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=DeliveryDB;Username=admin;Password=password123"
  },
  "Jwt": {
    "Key": "__SET_VIA_USER_SECRETS_OR_ENV__",
    "Issuer": "DeliveryBackendApi",
    "Audience": "DeliveryClients"
  },
  "Authentication": {
    "SessionLifetimeHours": 24,
    "RequireSecureCookie": true,
    "CookieSameSite": "Lax"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:80"
    ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },
  "SecurityHeaders": {
    "Enabled": true
  }
}
