{
  "name": "test-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API Server and Worker Node for Testing Dashboard",
  "main": "dist/api-server/server.js",
  "scripts": {
    "build": "tsc",
    "start:api": "node dist/api-server/server.js",
    "start:worker": "node dist/workers/worker.js",
    "dev:api": "ts-node-dev --respawn --transpile-only api-server/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only workers/worker.ts"
  },
  "dependencies": {
    "bullmq": "^5.41.3",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "socket.io": "^4.7.5",
    "tar-stream": "^3.2.0",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^9.0.8",
    "@types/xml2js": "^0.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
